# Reference only. scripts/init-local.ps1 generates random secrets in .local/platform.env.
AUTH_MODE=local
LOCAL_TOKEN=
ENCRYPTION_KEY=
DATABASE_PASSWORD=
HARBOR_PASSWORD=
HARBOR_USER=admin
HARBOR_URL=https://harbor.platform.test:30443
CPU_TEST=true
CALLER_SUBJECT=local-operator
PROJECT_ID=local
WORKLOAD_NAMESPACE=platform-workloads
CLUSTER_ID=local-kind
# Production: AUTH_MODE=jwt, CPU_TEST=false, HTTPS issuer and matching audience required.
# JWT_ISSUER=https://identity.example/realms/platform
# JWT_AUDIENCE=cluster-platform
# PLATFORM_ROLE=api
# DATABASE_URL=jdbc:postgresql://localhost:55432/platform
# Worker only: PLATFORM_ROLE=worker and PLATFORM_KUBECONFIG=<protected path>
